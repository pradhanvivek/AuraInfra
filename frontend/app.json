{
  "expo": {
    "name": "AuraInfra.ai",
    "slug": "aurainfra-ai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurainfra",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurainfra.ai",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AuraInfra uses your camera to let you photograph properties, vehicles, appliances, jewelry, furniture, and art so you can catalog and track your assets.",
        "NSPhotoLibraryUsageDescription": "AuraInfra lets you select existing photos to attach to your assets and community records.",
        "NSMotionUsageDescription": "AuraInfra uses device orientation while you measure and estimate painting requirements for a property."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1B33"
      },
      "package": "com.aurainfra.ai",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1B33"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AuraInfra uses your camera to let you photograph properties, vehicles, appliances, jewelry, furniture, and art so you can catalog and track your assets.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AuraInfra lets you select existing photos to attach to your assets and community records.",
          "cameraPermission": "AuraInfra uses your camera to let you photograph your assets directly from the app.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
